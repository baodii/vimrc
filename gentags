#!/usr/bin/env bash
set -euo pipefail

usage() {
  printf 'Usage: %s [project-root]\n' "${0##*/}"
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  usage
  exit 0
fi

if (($# > 1)); then
  usage >&2
  exit 2
fi

for tool in find ctags cscope; do
  if ! command -v "$tool" >/dev/null 2>&1; then
    printf 'error: required command not found: %s\n' "$tool" >&2
    exit 127
  fi
done

root="${1:-$PWD}"
if [[ ! -d "$root" ]]; then
  printf 'error: project root does not exist: %s\n' "$root" >&2
  exit 1
fi

root="$(cd "$root" && pwd -P)"
cscope_dir="$root/cscope"
files_file="$cscope_dir/cscope.files"
tags_file="$root/tags"
cscope_db="$root/cscope.out"

mkdir -p "$cscope_dir"

printf 'Finding source files under %s ...\n' "$root"
find "$root" \
  \( -type d \( \
    -name .git \
    -o -name .hg \
    -o -name .svn \
    -o -name .venv \
    -o -name build \
    -o -name cscope \
    -o -name node_modules \
    -o -name vendor \
    -o -name __pycache__ \
  \) -prune \) -o \
  \( -type f \( \
    -name '*.[ch]' \
    -o -name '*.cc' \
    -o -name '*.cl' \
    -o -name '*.cpp' \
    -o -name '*.cu' \
    -o -name '*.cuh' \
    -o -name '*.hxx' \
    -o -name '*.hpp' \
    -o -name '*.inc' \
    -o -name '*.java' \
    -o -name '*.php' \
    -o -name '*.properties' \
    -o -name '*.py' \
  \) -print \) > "$files_file"

file_count="$(wc -l < "$files_file")"
printf 'Indexed %s files in %s\n' "$file_count" "$files_file"

printf 'Generating tags at %s ...\n' "$tags_file"
ctags -f "$tags_file" -L "$files_file" --langmap=c++:+.inc.cl.cu.cuh

printf 'Generating cscope database at %s ...\n' "$cscope_db"
cscope -b -i "$files_file" -f "$cscope_db"

export CSCOPE_DB="$cscope_db"
if [[ "${BASH_SOURCE[0]}" != "$0" ]]; then
  printf 'Exported CSCOPE_DB=%s\n' "$CSCOPE_DB"
else
  printf 'Set cscope for this shell with: export CSCOPE_DB=%q\n' "$cscope_db"
fi
